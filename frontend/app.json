{
  "expo": {
    "name": "Zatriz",
    "slug": "zatriz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.vendorrackplan.k3glp6",
      "infoPlist": {
        "NSCameraUsageDescription": "Fotografar dispositivos e ler etiquetas QR",
        "NSPhotoLibraryUsageDescription": "Enviar plantas e fotos de dispositivos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.vendorrackplan.k3glp6",
      "permissions": ["android.permission.CAMERA", "android.permission.READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-sharing",
      "@react-native-vector-icons/ionicons",
      [
        "expo-camera",
        {
          "cameraPermission": "Fotografar dispositivos e ler etiquetas QR"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Enviar plantas e fotos de dispositivos",
          "cameraPermission": "Fotografar dispositivos no local"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
